{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build current program",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${file}",
        "-o",
        "${workspaceFolder}/bin/${fileBasenameNoExtension}"
